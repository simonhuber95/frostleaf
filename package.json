{
  "name": "frostleaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scientific garden planning app",
  "scripts": {
    "dev": "docker compose up -d db && concurrently \"pnpm -F @frostleaf/backend dev\" \"pnpm -F @frostleaf/frontend dev\"",
    "build": "pnpm -F @frostleaf/shared build && pnpm -F @frostleaf/backend build && pnpm -F @frostleaf/frontend build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -F @frostleaf/shared typecheck && pnpm -F @frostleaf/backend typecheck && pnpm -F @frostleaf/frontend typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx backend/src/db/seed.ts",
    "generate:trefle": "openapi-typescript docs/trefle-swagger.yaml -o backend/src/types/trefle.generated.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
